// Generated by local-dev/lib/common.sh: the folder list and the work area
// paths are filled in per workspace.
{
  // One folder per repo. Pylance and the mypy extension run one instance per
  // folder, so the work area root is the only folder that contains others,
  // and its own copies of the repos are excluded below.
  "folders": [
@FOLDERS@
    { "name": "workarea", "path": "." }
  ],
  "settings": {
    // Disabled by default, as Pylance is very resource-intensive in this workspace.
    "python.languageServer": "None",
    "python.defaultInterpreterPath": "@WORKSPACE_DIR@/.venv/bin/python",
    // DAQ PATH/PYTHONPATH/LD_LIBRARY_PATH, written by .devcontainer/write-vscode-env.sh
    "python.envFile": "@WORKSPACE_DIR@/vscode.env",
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "ruff.importStrategy": "fromEnvironment",

    // Paths are relative to each folder. pythoncode/sourcecode only match in
    // the workarea folder, where the repos would otherwise be analysed twice.
    // The first three entries are Pylance's defaults, which this setting replaces.
    "python.analysis.exclude": [
      "**/node_modules",
      "**/__pycache__",
      "**/.*",
      "build",
      "install",
      "log",
      "cache",
      "pythoncode",
      "sourcecode"
    ],
    "files.exclude": {
      "pythoncode": true,
      "sourcecode": true
    },
    "files.watcherExclude": {
      "**/.venv/**": true,
      "**/build/**": true,
      "**/install/**": true,
      "**/log/**": true,
      "**/.mypy_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.pytest_cache/**": true,
      "**/__pycache__/**": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/build": true,
      "**/install": true,
      "**/log": true,
      "**/.mypy_cache": true
    },

    // C++: use the compile database dbt-build writes instead of having
    // cpptools parse the whole workspace, and don't let CMake Tools try to
    // configure sourcecode/CMakeLists.txt itself (dbt-build owns the build).
    "C_Cpp.default.compileCommands": "@WORKSPACE_DIR@/build/compile_commands.json",
    "cmake.configureOnOpen": false
  }
}
