{
  "name": "dunedaq-alma9",
  "image": "ghcr.io/dune-daq/nightly-release-alma9:development_v5",
  "runArgs": [
    "--userns=host",
    "--security-opt", "label=disable"
  ],
  // Mount the folder at the same path it has on the host: a dbt work area and
  // its .venv contain absolute paths, so they only work where they were created.
  //
  // The same file serves two roles:
  //  - local-dev/.devcontainer: a bootstrap container to run the
  //    drunc_dev_*.sh scripts in (no work area, so no DAQ env is loaded).
  //  - <workspace>/.devcontainer: copied into every workspace, where the
  //    workspace folder is the dbt work area.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=/cvmfs/dunedaq.opensciencegrid.org,target=/cvmfs/dunedaq.opensciencegrid.org,type=bind,readonly",
    "source=/cvmfs/dunedaq-development.opensciencegrid.org,target=/cvmfs/dunedaq-development.opensciencegrid.org,type=bind,readonly"
  ],
  "overrideCommand": true,

  // Load the DAQ work area environment in every shell, and in the env VS Code
  // hands to extensions (Python, debugger, test runner).
  "containerEnv": {
    "DUNE_WORKAREA": "${containerWorkspaceFolder}"
  },
  "userEnvProbe": "loginInteractiveShell",
  // Lifecycle commands are baked into the container when it is created: after
  // editing them, run "Dev Containers: Rebuild Container" or they will not run.
  //
  // Everything runs on every start (idempotent) rather than in postCreateCommand,
  // so a restarted container always comes back working. See post-start.sh.
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "ms-python.mypy-type-checker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "ruff.importStrategy": "fromEnvironment"
      }
    }
  }
}
